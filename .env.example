APP_NAME="Inventario Tienda"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=es

LOG_CHANNEL=stack

# Base de datos: SQLite por defecto (database/database.sqlite)
DB_CONNECTION=sqlite
# Para MySQL, cambia a DB_CONNECTION=mysql y descomenta:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=inventario_tienda
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
